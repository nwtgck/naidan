{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable", "dom.asynciterable"],

    /* Strict Type-Checking Options */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,

    /* Additional Checks */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "types": ["node", "vite-plugin-pwa/client", "vite-plugin-pwa/vue"],
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "build/transformers-js-fixes/**/*.ts", "build/bicore-artifact-package.ts", "build/native-licenses/index-types.ts", "build/native-licenses/llama-index.ts", "build/native-licenses/image-index.ts", "build/native-licenses/typecheck.ts", "build/native-licenses/collect.ts", "build/native-licenses/load.ts", "build/llama-gpu-profile.test-support.ts", "build/node-env.ts", "build/gzip-asset.ts", "build/runtime-asset-middleware.test-support.ts", "./typed-router.d.ts"],
  "exclude": ["src/test-tmp"]
}
