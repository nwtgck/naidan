{
  "name": "naidan",
  "private": true,
  "version": "0.68.1-dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:all",
    "build:all": "npm run build:standalone && npm run build:hosted",
    "build:standalone": "vite build --mode standalone --logLevel warn",
    "build:hosted": "vite build --mode hosted --logLevel warn",
    "preview": "vite preview",
    "test": "vitest",
    "test:pwa": "vitest run --config vitest.pwa.config.ts",
    "test:only-failed": "vitest --reporter=./src/FailedOnlyReporter.ts --run",
    "strings:catalogs": "tsx scripts/generate-string-catalogs.ts",
    "strings:catalogs:check": "tsx scripts/generate-string-catalogs.ts --check",
    "strings:catalogs:test": "npm run test:only-failed -- --config build/boundary-strings/vitest.catalogs.config.ts",
    "typecheck": "vue-tsc -b && tsc --noEmit -p pwa/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix",
    "lint:ci:strings-components": "eslint src/strings src/components --max-warnings 0 --concurrency off",
    "lint:ci:other": "eslint . --ignore-pattern 'src/strings/**' --ignore-pattern 'src/components/**' --max-warnings 0 --concurrency off",
    "build:docs": "npm run typecheck:docs && vite build --config docs/vite.config.ts",
    "typecheck:docs": "vue-tsc --noEmit -p docs/tsconfig.json",
    "test:docs": "vitest run --config docs/vitest.config.ts docs",
    "lint:docs": "eslint docs build/docs-dev-bridge.ts --max-warnings 0",
    "test:model-pages": "vitest run --config build/vitest.model-pages.config.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@vueuse/core": "^15.0.0",
    "comlink": "^4.4.2",
    "dompurify": "^3.4.17",
    "file-type": "^22.3.0",
    "he": "^2.0.0",
    "highlight.js": "^11.12.0",
    "katex": "0.19.1",
    "llama-cpp-browser-core": "github:nwtgck/browser-inference-core#2f5fe8bc5bc1e5f40d1193b42d64376fcb5e1fc3",
    "lucide-vue-next": "^0.577.0",
    "marked": "^18.1.3",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "11.17.2",
    "nanoid": "^6.0.2",
    "stable-diffusion-cpp-browser-core": "github:nwtgck/browser-inference-core#3487c5aafc890f5429d491db11f09f7de59a6066",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "vuedraggable": "^4.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/parser": "^8.1.0",
    "@babel/plugin-transform-dynamic-import": "^8.0.1",
    "@babel/plugin-transform-modules-systemjs": "^8.1.0",
    "@babel/traverse": "^8.1.0",
    "@babel/types": "^8.1.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/he": "^1.2.3",
    "@types/jsdom": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/babel-plugin-jsx": "^3.0.0",
    "@vue/compiler-dom": "^3.5.44",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/language-core": "^3.3.14",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@vue/typescript": "^1.8.20",
    "autoprefixer": "^10.6.2",
    "css-tree": "^3.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.2",
    "magic-string": "^1.4.5",
    "postcss": "^8.5.32",
    "postcss-value-parser": "^4.2.0",
    "rolldown": "1.2.16",
    "rollup-plugin-license": "^3.7.1",
    "systemjs": "6.15.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
