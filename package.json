{
  "name": "naidan",
  "private": true,
  "version": "0.37.1-dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && npm run build:all",
    "build:all": "npm run build:standalone && npm run build:hosted",
    "build:standalone": "vite build --mode standalone --logLevel warn",
    "build:hosted": "vite build --mode hosted --logLevel warn",
    "preview": "vite preview",
    "test": "vitest",
    "test:only-failed": "vitest --reporter=./src/FailedOnlyReporter.ts --run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "@vueuse/core": "^14.3.0",
    "comlink": "^4.4.2",
    "dompurify": "^3.4.11",
    "file-type": "^22.0.1",
    "he": "^1.2.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "lucide-vue-next": "^0.562.0",
    "marked": "^18.0.5",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.10",
    "mermaid": "11.16.0",
    "nanoid": "^5.1.16",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "vuedraggable": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@babel/plugin-transform-modules-systemjs": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.2",
    "@tailwindcss/typography": "0.5.20",
    "@types/babel__core": "^7.20.5",
    "@types/he": "^1.2.3",
    "@types/jsdom": "^28.0.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/compiler-sfc": "^3.5.39",
    "@vue/language-core": "^3.3.6",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "@vue/typescript": "^1.8.20",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "magic-string": "^0.30.21",
    "postcss": "^8.5.16",
    "postcss-value-parser": "^4.2.0",
    "rolldown": "1.1.4",
    "rollup-plugin-license": "^3.7.1",
    "systemjs": "6.15.1",
    "tailwindcss": "4.3.2",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^4.1.1",
